{
  "name": "@edge-manifest/cli",
  "version": "0.0.0",
  "description": "CLI for EDGE-MANIFEST",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "edge-manifest": "./dist/bin/edge-manifest.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@edge-manifest/core": "workspace:*",
    "@edge-manifest/generators": "workspace:*",
    "esbuild": "^0.25.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.4",
    "tslib": "^2.8.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.1.0",
    "typescript": "latest",
    "vitest": "^1.1.0"
  }
}
